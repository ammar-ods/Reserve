datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  HOST
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum VisitPeriod {
  MORNING
  EVENING
}

enum ActionType {
  CREATE
  UPDATE
  CANCEL
  DELETE
  LOCK_ACQUIRED
  LOCK_RELEASED
  SETTING_UPDATE
}

model User {
  id           String      @id @default(uuid())
  adminId      String      @unique // e.g. "SA-01", "ADM-01", "HOST-01"
  username     String      @unique // Login handle, e.g. "superadmin"
  passwordHash String      // scrypt hash, never a plain password
  name         String
  role         Role        @default(HOST)
  isActive     Boolean     @default(true)
  createdBy    String?     // adminId of the Admin / Super Admin who registered this account
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditLogs    AuditLog[]
}

model Campsite {
  id              String        @id @default(uuid())
  slug            String        @unique // e.g. "day-use", "standard-camp", "elite-camp", "private-camp"
  name            String
  description     String?
  dailyCapacity   Int           @default(3) // Hard limit on active reservations sharing any single day
  morningCapacity Int           @default(3) // Day-use only: cap for the morning period
  eveningCapacity Int           @default(3) // Day-use only: cap for the evening period
  iconName        String        @default("Tent")
  sortOrder       Int           @default(0) // Display order of the campsites everywhere in the UI
  reservations    Reservation[]
  locks           ActiveLock[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Reservation {
  id                String            @id @default(uuid())
  reservationNumber String            @unique // e.g. "RES-2026-0001"
  campsiteId        String
  campsite          Campsite          @relation(fields: [campsiteId], references: [id], onDelete: Cascade)

  // Booking data fields:
  customerName      String
  customerPhone     String
  country           String            @default("AE") // ISO 3166-1 alpha-2 code of the visitor
  guestCount        Int               @default(1)
  rentedTents       Int               @default(0)
  rentedCars        Int               @default(0)
  rentedBirds       Int               @default(0) // عدد الطيور
  rentedHoubara     Int               @default(0) // عدد الحبارى
  rentedRabbits     Int               @default(0)
  rentedSalukis     Int               @default(0)
  rentedGazelles    Int               @default(0)
  visitPeriod       VisitPeriod?
  campType          String?
  notes             String?

  // Deposit is typed in manually by the host and is never required.
  totalAmount       Float             @default(0)
  depositAmount     Float?

  startDate         DateTime          // Visit Start Date
  endDate           DateTime          // Visit End Date
  status            ReservationStatus @default(PENDING)

  createdByAdminId  String            // Host Admin ID who took the phone call
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([campsiteId, startDate, endDate])
  @@index([status])
  @@index([country])
}

model ActiveLock {
  id          String   @id @default(uuid())
  campsiteId  String
  campsite    Campsite @relation(fields: [campsiteId], references: [id], onDelete: Cascade)
  hostAdminId String  // e.g. "HOST-01"
  hostName    String
  visitPeriod VisitPeriod? // Day-use holds occupy one period, not the whole day
  startDate   DateTime
  endDate     DateTime
  expiresAt   DateTime // TTL for temporary lock
  createdAt   DateTime @default(now())

  @@index([campsiteId, expiresAt])
}

model AuditLog {
  id           String     @id @default(uuid())
  action       ActionType
  adminId      String?    // Host Admin ID; cleared when that account is deleted
  userRole     Role
  userName     String
  targetType   String     // "RESERVATION", "CAMPSITE", "LOCK", "SETTINGS", "USER"
  targetId     String?
  targetLabel  String?    // Human readable target, e.g. "RES-2026-0001 - Ahmed"
  campsiteName String?
  details      String     // Short description of the event
  changes      Json?      // [{ field, labelKey, before, after }] shown in the Super Admin detail popup
  timestamp    DateTime   @default(now())

  user         User?      @relation(fields: [adminId], references: [adminId], onDelete: SetNull)

  @@index([timestamp(sort: Desc)])
}

model SystemSetting {
  id           String   @id @default("global_config")
  pageTitle    String   @default("حجوزات محمية المرزوم")
  tableHeaders Json     // Customizable column labels editable by Admin

  // Unit prices for the rentable items, managed by the Admin next to the daily caps.
  priceTent    Float    @default(0)
  priceCar     Float    @default(0)
  priceBird    Float    @default(0)
  priceRabbit  Float    @default(0)

  updatedBy    String?
  updatedAt    DateTime @updatedAt
}
